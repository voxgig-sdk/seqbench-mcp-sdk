# Entity: gene_model

main: kit: entity: gene_model: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "gene"
      req: true
      short: "A human gene symbol (\"TP53\") or Ensembl gene ID (\"ENSG00000141510\")."
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "gene_model"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/gene_model"
          parts: [
            "gene_model"
          ]
          transform: {
            req: {
              gene: "`reqdata.gene`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
