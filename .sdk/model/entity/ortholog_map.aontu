# Entity: ortholog_map

main: kit: entity: ortholog_map: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "sourceSpecies"
      req: false
      type: "`$STRING`"
    }
    {
      name: "symbols"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "targetSpecies"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "ortholog_map"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/ortholog_map"
          parts: [
            "ortholog_map"
          ]
          transform: {
            req: {
              sourceSpecies: "`reqdata.source_species`"
              symbols: "`reqdata.symbol`"
              targetSpecies: "`reqdata.target_species`"
              type: "`reqdata.type`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
