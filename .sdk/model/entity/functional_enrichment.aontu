# Entity: functional_enrichment

main: kit: entity: functional_enrichment: {

  alias: field: {}

  fields: [
    {
      name: "background"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "collections"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "genes"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "maxTermSize"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "minTermSize"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "functional_enrichment"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/functional_enrichment"
          parts: [
            "functional_enrichment"
          ]
          transform: {
            req: {
              background: "`reqdata.background`"
              collections: "`reqdata.collection`"
              genes: "`reqdata.gene`"
              maxTermSize: "`reqdata.max_term_size`"
              minTermSize: "`reqdata.min_term_size`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
