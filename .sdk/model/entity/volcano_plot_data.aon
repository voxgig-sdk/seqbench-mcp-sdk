# Entity: volcano_plot_data

main: kit: entity: volcano_plot_data: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "rows"
      req: true
      short: "Differential expression rows, one per gene."
      type: "`$ARRAY`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "volcano_plot_data"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/volcano_plot_data"
          parts: [
            "volcano_plot_data"
          ]
          transform: {
            req: {
              rows: "`reqdata.row`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
