# Entity: protein_annotate_poll

main: kit: entity: protein_annotate_poll: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "jobId"
      req: true
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "protein_annotate_poll"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/protein_annotate_poll"
          parts: [
            "protein_annotate_poll"
          ]
          transform: {
