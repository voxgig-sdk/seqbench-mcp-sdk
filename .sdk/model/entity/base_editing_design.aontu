# Entity: base_editing_design

main: kit: entity: base_editing_design: {

  alias: field: {}

  fields: [
    {
      name: "editor"
      req: false
      type: "`$STRING`"
    }
    {
      name: "frameStart"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "target"
      req: true
      type: "`$STRING`"
    }
    {
      name: "targetPosition"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "base_editing_design"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/base_editing_design"
          parts: [
            "base_editing_design"
          ]
          transform: {
            req: {
              editor: "`reqdata.editor`"
              frameStart: "`reqdata.frame_start`"
              target: "`reqdata.target`"
              targetPosition: "`reqdata.target_position`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
