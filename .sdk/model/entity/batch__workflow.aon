# Entity: batch__workflow

main: kit: entity: batch__workflow: {

  alias: field: {}

  fields: [
    {
      name: "capped"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "columns"
      req: true
      short: "Flattened \"<step>·<tool>·<key>\" column headers."
      type: "`$ARRAY`"
    }
    {
      name: "count"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "errors"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "input"
      req: true
      short: "Multi-FASTA text or one sequence per line."
      type: "`$STRING`"
    }
    {
      name: "limit"
      req: true
      short: "Maximum records per call (200)."
      type: "`$INTEGER`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "rows"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "steps"
      req: true
      type: "`$ARRAY`"
    }
  ]

  name: "batch__workflow"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/workflow"
          parts: [
            "workflow"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.result`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/workflow"
          parts: [
            "workflow"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
