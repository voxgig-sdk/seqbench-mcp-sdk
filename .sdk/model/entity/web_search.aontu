# Entity: web_search

main: kit: entity: web_search: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "max_results"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "query"
      req: true
      type: "`$STRING`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "web_search"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/web_search"
          parts: [
            "web_search"
          ]
          transform: {
            req: {
              max_results: "`reqdata.max_result`"
              query: "`reqdata.query`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
