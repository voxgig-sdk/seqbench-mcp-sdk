# Entity: multiple_sequence_alignment

main: kit: entity: multiple_sequence_alignment: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "input"
      req: true
      short: "Two or more sequences in multi-FASTA format (>name / sequence)."
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "multiple_sequence_alignment"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/multiple_sequence_alignment"
          parts: [
            "multiple_sequence_alignment"
          ]
          transform: {
            req: {
              input: "`reqdata.input`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
