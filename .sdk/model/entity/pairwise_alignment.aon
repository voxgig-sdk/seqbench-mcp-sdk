# Entity: pairwise_alignment

main: kit: entity: pairwise_alignment: {

  alias: field: {}

  fields: [
    {
      name: "gap"
      req: false
      short: "Linear gap penalty (per gap position)."
      type: "`$NUMBER`"
    }
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "match"
      req: false
      short: "Match score."
      type: "`$NUMBER`"
    }
    {
      name: "mismatch"
      req: false
      short: "Mismatch penalty."
      type: "`$NUMBER`"
    }
    {
      name: "mode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "seqA"
      req: true
      short: "First sequence (raw or FASTA; nucleotide or protein)."
      type: "`$STRING`"
    }
    {
      name: "seqB"
      req: true
      short: "Second sequence (raw or FASTA; nucleotide or protein)."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "pairwise_alignment"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/pairwise_alignment"
          parts: [
            "pairwise_alignment"
          ]
          transform: {
            req: {
              gap: "`reqdata.gap`"
              match: "`reqdata.match`"
              mismatch: "`reqdata.mismatch`"
              mode: "`reqdata.mode`"
              seqA: "`reqdata.seq_a`"
              seqB: "`reqdata.seq_b`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
