# Entity: session_get

main: kit: entity: session_get: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "names"
      req: false
      short: "Only return these entries; omit to return all of them."
      type: "`$ARRAY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "sessionId"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "session_get"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/session_get"
          parts: [
            "session_get"
          ]
          transform: {
            req: {
              names: "`reqdata.name`"
              sessionId: "`reqdata.session_id`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
