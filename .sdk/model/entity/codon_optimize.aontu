# Entity: codon_optimize

main: kit: entity: codon_optimize: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "organism"
      req: false
      type: "`$STRING`"
    }
    {
      name: "protein"
      req: true
      type: "`$STRING`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "codon_optimize"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/codon_optimize"
          parts: [
            "codon_optimize"
          ]
          transform: {
            req: {
              organism: "`reqdata.organism`"
              protein: "`reqdata.protein`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
