# Entity: sequence_search

main: kit: entity: sequence_search: {

  alias: field: {}

  fields: [
    {
      name: "db"
      req: false
      type: "`$STRING`"
    }
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "gene"
      req: false
      type: "`$STRING`"
    }
    {
      name: "maxResults"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "organism"
      req: false
      type: "`$STRING`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "term"
      req: false
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "sequence_search"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/sequence_search"
          parts: [
            "sequence_search"
          ]
          transform: {
            req: {
              db: "`reqdata.db`"
              gene: "`reqdata.gene`"
              maxResults: "`reqdata.max_result`"
              organism: "`reqdata.organism`"
              term: "`reqdata.term`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
