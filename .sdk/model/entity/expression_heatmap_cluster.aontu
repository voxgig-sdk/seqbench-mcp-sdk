# Entity: expression_heatmap_cluster

main: kit: entity: expression_heatmap_cluster: {

  alias: field: {}

  fields: [
    {
      name: "clusterCols"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "clusterRows"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "distanceMetric"
      req: false
      type: "`$STRING`"
    }
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "genes"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "linkage"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "samples"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
    {
      name: "values"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "zScoreRows"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "expression_heatmap_cluster"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/expression_heatmap_cluster"
          parts: [
            "expression_heatmap_cluster"
          ]
          transform: {
            req: {
              clusterCols: "`reqdata.cluster_col`"
              clusterRows: "`reqdata.cluster_row`"
              distanceMetric: "`reqdata.distance_metric`"
              genes: "`reqdata.gene`"
              linkage: "`reqdata.linkage`"
              samples: "`reqdata.sample`"
              values: "`reqdata.value`"
              zScoreRows: "`reqdata.z_score_row`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
