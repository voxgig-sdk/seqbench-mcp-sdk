# Entity: site_directed_mutagenesi

main: kit: entity: site_directed_mutagenesi: {

  alias: field: {}

  fields: [
    {
      name: "armTmTarget"
      req: false
      short: "Target Tm (°C) for each template-binding arm."
      type: "`$NUMBER`"
    }
    {
      name: "dntpMM"
      req: false
      short: "Total [dNTP] (mM), chelates Mg2+."
      type: "`$NUMBER`"
    }
    {
      name: "editKind"
      req: false
      short: "Edit at the nucleotide or amino-acid level."
      type: "`$STRING`"
    }
    {
      name: "frameStart"
      req: false
      short: "1-based position of the first base of codon 1 (editKind='aa')."
      type: "`$INTEGER`"
    }
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "mgMM"
      req: false
      short: "Divalent cation [Mg2+] (mM)."
      type: "`$NUMBER`"
    }
    {
      name: "naMM"
      req: false
      short: "Monovalent cation [Na+]/[K+] (mM)."
      type: "`$NUMBER`"
    }
    {
      name: "newBase"
      req: false
      short: "Replacement base (editKind='nt')."
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "oligoNM"
      req: false
      short: "Total strand concentration (nM)."
      type: "`$NUMBER`"
    }
    {
      name: "organism"
      req: false
      short: "Codon-usage table for choosing the new codon (editKind='aa')."
      type: "`$STRING`"
    }
    {
      name: "position"
      req: false
      short: "1-based position to substitute (editKind='nt')."
      type: "`$INTEGER`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "residue"
      req: false
      short: "1-based residue number to change (editKind='aa')."
      type: "`$INTEGER`"
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "style"
      req: false
      short: "Mutagenic primer style."
      type: "`$STRING`"
    }
    {
      name: "targetAa"
      req: false
      short: "Target amino acid, one-letter code incl '*' (editKind='aa')."
      type: "`$STRING`"
    }
    {
      name: "template"
      req: true
      short: "Nucleotide sequence (raw or FASTA; IUPAC accepted)."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "site_directed_mutagenesi"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /site_directed_mutagenesis"
            json: "{\"operationId\":\"site_directed_mutagenesis\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"armTmTarget\":{\"default\":60,\"description\":\"Target Tm (°C) for each template-binding arm.\",\"type\":\"number\"},\"dntpMM\":{\"default\":0.2,\"description\":\"Total [dNTP] (mM), chelates Mg2+.\",\"type\":\"number\"},\"editKind\":{\"default\":\"aa\",\"description\":\"Edit at the nucleotide or amino-acid level.\",\"enum\":[\"nt\",\"aa\"],\"type\":\"string\"},\"frameStart\":{\"default\":1,\"description\":\"1-based position of the first base of codon 1 (editKind='aa').\",\"type\":\"integer\"},\"mgMM\":{\"default\":1.5,\"description\":\"Divalent cation [Mg2+] (mM).\",\"type\":\"number\"},\"naMM\":{\"default\":50,\"description\":\"Monovalent cation [Na+]/[K+] (mM).\",\"type\":\"number\"},\"newBase\":{\"description\":\"Replacement base (editKind='nt').\",\"enum\":[\"A\",\"C\",\"G\",\"T\"],\"type\":\"string\"},\"oligoNM\":{\"default\":250,\"description\":\"Total strand concentration (nM).\",\"type\":\"number\"},\"organism\":{\"default\":\"ecoli\",\"description\":\"Codon-usage table for choosing the new codon (editKind='aa').\",\"enum\":[\"ecoli\",\"human\",\"yeast\",\"cho\",\"pichia\",\"insect\",\"arabidopsis\",\"zebrafish\"],\"type\":\"string\"},\"position\":{\"description\":\"1-based position to substitute (editKind='nt').\",\"type\":\"integer\"},\"residue\":{\"description\":\"1-based residue number to change (editKind='aa').\",\"type\":\"integer\"},\"style\":{\"default\":\"quikchange\",\"description\":\"Mutagenic primer style.\",\"enum\":[\"quikchange\",\"q5\"],\"type\":\"string\"},\"targetAa\":{\"description\":\"Target amino acid, one-letter code incl '*' (editKind='aa').\",\"type\":\"string\"},\"template\":{\"description\":\"Nucleotide sequence (raw or FASTA; IUPAC accepted).\",\"type\":\"string\"}},\"required\":[\"template\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Standard success envelope returned by every single-tool call.\",\"properties\":{\"gate\":{\"description\":\"Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g. no targetTm).\",\"oneOf\":[{\"properties\":{\"checks\":{\"items\":{\"properties\":{\"id\":{\"type\":\"string\"},\"label\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"pass\":{\"type\":\"boolean\"},\"severity\":{\"enum\":[\"hard\",\"soft\"],\"type\":\"string\"},\"threshold\":{\"type\":\"string\"},\"value\":{\"type\":\"number\"}},\"required\":[\"id\",\"label\",\"severity\",\"pass\",\"message\"],\"type\":\"object\"},\"type\":\"array\"},\"notChecked\":{\"description\":\"Honest list of what this gate does NOT verify.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"pass\":{\"description\":\"True if and only if every hard check passed.\",\"type\":\"boolean\"}},\"required\":[\"pass\",\"checks\",\"notChecked\"],\"type\":\"object\"},{\"type\":\"null\"}]},\"ok\":{\"const\":true},\"provenance\":{\"properties\":{\"apiVersion\":{\"example\":\"1.1.0\",\"type\":\"string\"},\"generatedAt\":{\"description\":\"ISO 8601 timestamp of when the result was generated.\",\"format\":\"date-time\",\"type\":\"string\"},\"tool\":{\"description\":\"Tool slug, or an array of slugs (one per step) for a workflow.\",\"oneOf\":[{\"type\":\"string\"},{\"items\":{\"type\":\"string\"},\"type\":\"array\"}]}},\"required\":[\"apiVersion\",\"tool\",\"generatedAt\"],\"type\":\"object\"},\"result\":{\"additionalProperties\":true,\"description\":\"Tool-specific output object. Its shape depends on the tool — call `GET /{tool}` or see the docs for each tool's fields.\",\"type\":\"object\"},\"tool\":{\"description\":\"The tool slug that ran.\",\"type\":\"string\"}},\"required\":[\"ok\",\"tool\",\"result\",\"provenance\"],\"type\":\"object\"}}},\"description\":\"Tool ran successfully.\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Standard error envelope for single-tool calls.\",\"properties\":{\"code\":{\"enum\":[\"invalid_argument\",\"unsupported\",\"upstream_unavailable\",\"upstream_timeout\",\"rate_limited\",\"internal_error\"],\"type\":\"string\"},\"error\":{\"description\":\"Human-readable error message.\",\"type\":\"string\"},\"ok\":{\"const\":false},\"retryable\":{\"type\":\"boolean\"},\"suggestedAction\":{\"type\":\"string\"},\"tool\":{\"type\":\"string\"}},\"required\":[\"ok\",\"error\"],\"type\":\"object\"}}},\"description\":\"Invalid argument or the tool could not run.\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Standard error envelope for single-tool calls.\",\"properties\":{\"code\":{\"enum\":[\"invalid_argument\",\"unsupported\",\"upstream_unavailable\",\"upstream_timeout\",\"rate_limited\",\"internal_error\"],\"type\":\"string\"},\"error\":{\"description\":\"Human-readable error message.\",\"type\":\"string\"},\"ok\":{\"const\":false},\"retryable\":{\"type\":\"boolean\"},\"suggestedAction\":{\"type\":\"string\"},\"tool\":{\"type\":\"string\"}},\"required\":[\"ok\",\"error\"],\"type\":\"object\"}}},\"description\":\"Unknown tool.\"}},\"security\":[{}],\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/site_directed_mutagenesis"
          segments: [
            {
              lit: "site_directed_mutagenesis"
            }
          ]
          transform: {
            req: {
              armTmTarget: "`reqdata.arm_tm_target`"
              dntpMM: "`reqdata.dntp_mm`"
              editKind: "`reqdata.edit_kind`"
              frameStart: "`reqdata.frame_start`"
              mgMM: "`reqdata.mg_mm`"
              naMM: "`reqdata.na_mm`"
              newBase: "`reqdata.new_base`"
              oligoNM: "`reqdata.oligo_nm`"
