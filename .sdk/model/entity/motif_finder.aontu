# Entity: motif_finder

main: kit: entity: motif_finder: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "maxMismatches"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "motif"
      req: true
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "searchReverseStrand"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "sequence"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "motif_finder"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/motif_finder"
          parts: [
            "motif_finder"
          ]
          transform: {
            req: {
              maxMismatches: "`reqdata.max_mismatch`"
              motif: "`reqdata.motif`"
              searchReverseStrand: "`reqdata.search_reverse_strand`"
              sequence: "`reqdata.sequence`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
