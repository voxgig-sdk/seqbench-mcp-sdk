# Entity: sirna_design

main: kit: entity: sirna_design: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "minReynolds"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "shRnaLoop"
      req: false
      type: "`$STRING`"
    }
    {
      name: "target"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "sirna_design"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/sirna_design"
          parts: [
            "sirna_design"
          ]
          transform: {
            req: {
              minReynolds: "`reqdata.min_reynold`"
              shRnaLoop: "`reqdata.sh_rna_loop`"
              target: "`reqdata.target`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
