# Entity: format_sequence

main: kit: entity: format_sequence: {

  alias: field: {}

  fields: [
    {
      name: "caseMode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "convert"
      req: false
      type: "`$STRING`"
    }
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "reverse"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "sequence"
      req: true
      type: "`$STRING`"
    }
    {
      name: "stripNonLetters"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
    {
      name: "width"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "format_sequence"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/format_sequence"
          parts: [
            "format_sequence"
          ]
          transform: {
            req: {
              caseMode: "`reqdata.case_mode`"
              convert: "`reqdata.convert`"
              reverse: "`reqdata.reverse`"
              sequence: "`reqdata.sequence`"
              stripNonLetters: "`reqdata.strip_non_letter`"
              width: "`reqdata.width`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
