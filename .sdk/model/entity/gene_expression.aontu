# Entity: gene_expression

main: kit: entity: gene_expression: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "gene"
      req: true
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "gene_expression"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/gene_expression"
          parts: [
            "gene_expression"
          ]
          transform: {
            req: {
              gene: "`reqdata.gene`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
