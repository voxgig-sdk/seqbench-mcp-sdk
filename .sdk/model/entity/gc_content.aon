# Entity: gc_content

main: kit: entity: gc_content: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "sequence"
      req: true
      short: "Nucleotide sequence (raw or FASTA; IUPAC accepted)."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "gc_content"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/gc_content"
          parts: [
            "gc_content"
          ]
          transform: {
            req: {
              sequence: "`reqdata.sequence`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
