# Entity: find_orf

main: kit: entity: find_orf: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "minAaLength"
      req: false
      short: "Minimum protein length (aa) to report."
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "requireStop"
      req: false
      short: "Only report ORFs terminated by a stop codon."
      type: "`$BOOLEAN`"
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "sequence"
      req: true
      short: "Nucleotide sequence (raw or FASTA; IUPAC accepted)."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "find_orf"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/find_orfs"
          segments: [
            {
              lit: "find_orfs"
            }
          ]
          transform: {
            req: {
              minAaLength: "`reqdata.min_aa_length`"
              requireStop: "`reqdata.require_stop`"
              sequence: "`reqdata.sequence`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
