# Entity: batch

main: kit: entity: batch: {

  alias: field: {}

  fields: [
    {
      name: "args"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "capped"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "columns"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "count"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "errors"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "input"
      req: true
      type: "`$STRING`"
    }
    {
      name: "limit"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "rows"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "batch"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/batch"
          parts: [
            "batch"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.result`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/batch"
          parts: [
            "batch"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
