      type: "`$OBJECT`"
    }
    {
      name: "input"
      req: true
      type: "`$STRING`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "batch"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/batch"
