# Entity: sirna_design

main: kit: entity: sirna_design: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "minReynolds"
      req: false
      short: "Minimum Reynolds score (0–8) to keep; falls back to best-ranked if none qualify."
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "shRnaLoop"
      req: false
      short: "Loop sequence used when assembling the shRNA cassette."
      type: "`$STRING`"
    }
    {
      name: "target"
      req: true
      short: "Nucleotide sequence (raw or FASTA; IUPAC accepted)."
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "sirna_design"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/sirna_design"
          parts: [
            "sirna_design"
          ]
          transform: {
            req: {
              minReynolds: "`reqdata.min_reynold`"
              shRnaLoop: "`reqdata.sh_rna_loop`"
              target: "`reqdata.target`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
