# Entity: aso_design

main: kit: entity: aso_design: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "length"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "target"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
    {
      name: "wing"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "aso_design"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/aso_design"
          parts: [
            "aso_design"
          ]
          transform: {
            req: {
              length: "`reqdata.length`"
              target: "`reqdata.target`"
              wing: "`reqdata.wing`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
