# Entity: codon_optimize

main: kit: entity: codon_optimize: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "organism"
      req: false
      type: "`$STRING`"
    }
    {
      name: "protein"
      req: true
      short: "Protein sequence (one-letter codes)."
      type: "`$STRING`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
      union: {
        branches: 2
        count: 1
        depth: 2
      }
    }
    {
      name: "result"
      req: true
      short: "Tool-specific output object."
      type: "`$OBJECT`"
    }
    {
      name: "tool"
      req: true
      short: "The tool slug that ran."
      type: "`$STRING`"
    }
  ]

  name: "codon_optimize"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/codon_optimize"
          segments: [
            {
              lit: "codon_optimize"
            }
          ]
          transform: {
            req: {
              organism: "`reqdata.organism`"
              protein: "`reqdata.protein`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
