# Entity: format_sequence

main: kit: entity: format_sequence: {

  alias: field: {}

  fields: [
    {
      name: "caseMode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "convert"
      req: false
      short: "DNA→RNA (T→U) or RNA→DNA (U→T)."
      type: "`$STRING`"
    }
    {
      name: "gate"
      req: false
      short: "Typed QC verdict, or null when the tool defines no gate or the call lacked gating inputs (e.g."
      type: "`$ANY`"
    }
