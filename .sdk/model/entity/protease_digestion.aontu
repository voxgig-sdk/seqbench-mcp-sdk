# Entity: protease_digestion

main: kit: entity: protease_digestion: {

  alias: field: {}

  fields: [
    {
      name: "gate"
      req: false
      type: "`$ANY`"
    }
    {
      name: "maxMass"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "maxPeptides"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "minMass"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "missedCleavages"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "ok"
      req: true
      type: "`$ANY`"
    }
    {
      name: "protease"
      req: false
      type: "`$STRING`"
    }
    {
      name: "provenance"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "result"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "sequence"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tool"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "protease_digestion"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/protease_digestion"
          parts: [
            "protease_digestion"
          ]
          transform: {
            req: {
              maxMass: "`reqdata.max_mass`"
              maxPeptides: "`reqdata.max_peptide`"
              minMass: "`reqdata.min_mass`"
              missedCleavages: "`reqdata.missed_cleavage`"
              protease: "`reqdata.protease`"
              sequence: "`reqdata.sequence`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }



}
